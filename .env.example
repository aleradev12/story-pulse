TELEGRAM_BOT_TOKEN=
SBER_API_KEY=
ADMIN_TELEGRAM_ID=

# Заполните значениями, выданными Sber500. Base URL должен быть корнем OpenAI-совместимого API.
SBER_BASE_URL=
# Укажите идентификатор модели из ответа GET /models.
SBER_MODEL=
TIME_ZONE=Europe/Moscow

# Для первого ручного теста оставьте false и используйте /open и /close.
AUTO_SCHEDULE=false
OPEN_HOUR=10
REMINDER_HOUR=19
CLOSE_HOUR=20

MAX_QUESTIONS_PER_ROUND=2
